# RobotForge — environment variables (EXAMPLE — no real values)
#
# Copy this file to ".env" and fill in your own keys from each provider's
# dashboard. ".env" is listed in .gitignore — never commit a filled copy,
# never paste a value into an issue, PR, or chat.
# Agents: refer to variables by NAME only. Never print or log a value.

# Meta Model API — hackathon credit. Powers the live endpoint's /photo route
# and the engine's meta describe transport (models: muse-spark-1.3, sam-3.1).
META_API_KEY=

# Baseten — hackathon credit. Powers live describe/chat/list on the
# Cloudflare Worker and the engine's baseten transport.
BASETEN_API_KEY=

# Fireworks — hackathon credit. Optional opt-in describe transport.
FIREWORKS_API_KEY=

# Cloudflare — only needed to deploy the live Worker with
# the cf_api.py helper (token needs: Workers Scripts Edit,
# Workers KV Storage Edit, Account Settings Read).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Roboflow — vision experiments.
ROBOFLOW_API_KEY=

# Modal — reserved; credit request pending, no key issued yet.
# MODAL_API_KEY=

# --- Live Worker variables (Cloudflare — plain vars, NOT secrets) ---
# The Worker's secrets are the provider keys above, set as encrypted
# secrets in the Cloudflare dashboard under these exact names:
# BASETEN_API_KEY, META_API_KEY, FIREWORKS_API_KEY.
# Kill switch: 1 (default) = live, 0 = endpoint off.
LIVE_ENABLED=
# Global daily call budget (default 200).
DAILY_LIMIT=
# Per-IP daily call budget (default 30).
PER_IP_DAILY_LIMIT=
# RF_LIVE_KV is a KV namespace BINDING on the Worker (budget counters),
# not an environment variable — it is configured in the dashboard /
# wrangler config, never in .env.

# --- RobotForge engine options (not secrets) ---
# Force one describe transport: meta-connector | baseten | fireworks
RF_DESCRIBE_TRANSPORT=
# Set to 1 to add Fireworks as a fallback describe transport.
RF_FIREWORKS_ENABLED=
# Model overrides (defaults: muse-spark-1.3 on Meta,
# meta-models/muse-spark-open on Baseten / Fireworks).
RF_MODEL=
RF_BASETEN_MODEL=
RF_FIREWORKS_MODEL=
# Fireworks API base override.
RF_FIREWORKS_API_BASE=
# Paths to the local connector helper scripts used by the meta /
# baseten transports (machine-specific; defaults are built in).
RF_META_API_HELPER=
RF_BASETEN_HELPER=
# Override the directory the robot catalog is loaded from.
ROBOTFORGE_CATALOG_DIR=
