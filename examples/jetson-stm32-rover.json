    "to": "driver",
    "volts": null,
    "bus": "pwm"
   },
   {
    "from": "driver",
    "kind": "power",
    "label": "PWM output — duty-limited, not a fixed rail",
    "to": "motors",
    "volts": null
   },
   {
    "from": "motors",
    "kind": "data",
    "label": "encoder feedback",
    "to": "stm32",
    "volts": null,
    "bus": "gpio"
   },
   {
    "from": "jetson",
    "kind": "data",
    "label": "USB 3",
    "to": "camera",
    "volts": null,
    "bus": "usb"
   }
  ],
  "note": "Jetson does vision and planning; the STM32 runs the motor loop in real time and reports encoder counts back over USB serial. USB carries 5 V and ground, so no level shifter or extra ground wire is needed between the two boards. The battery feeds the Jetson carrier board directly: check your carrier board's DC input range before wiring it."
 }
