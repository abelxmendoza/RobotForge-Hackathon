{
  "name": "turtlebot3-burger",
  "description": "Differential-drive reference robot in the TurtleBot3 Burger class: two driven wheels, caster support, 360 lidar. Public reference dimensions (ROBOTIS TurtleBot3, Apache-2.0).",
  "drivetrain": "differential",
  "length_m": 0.178,
  "width_m": 0.138,
  "height_m": 0.192,
  "mass_kg": 0.93,
  "ground_clearance_m": 0.02,
  "wheel": {
    "diameter_m": 0.066,
    "width_m": 0.022,
    "count": 2,
    "driven": true
  },
  "motor": {
    "kind": "dc_gearmotor",
    "count": 2,
    "voltage_v": 11.1,
    "stall_torque_nm": 0.3
  },
  "battery": {
    "chemistry": "lipo",
    "voltage_v": 11.1,
    "capacity_mah": 1800
  },
  "sensors": [
    {
      "kind": "lidar_2d",
      "position": "top",
      "range_m": 3.5
    }
  ],
  "component_mass_kg": {
    "wheels": 0.1,
    "motors": 0.2,
    "battery": 0.19,
    "chassis": 0.3,
    "electronics": 0.14
  },
  "wiring": {
    "note": "The spec names no computer or driver model for this robot, so the driver and controller appear as the distribution points the wiring passes through, with requirements 'not specified' where the data names none. Motor voltage is the spec's own: the motors are rated at the 11.1 V battery voltage.",
    "nodes": [
      {
        "id": "battery",
        "label": "Battery — LiPo",
        "req_label": "11.1 V",
        "rated_max_v": null,
        "kit": null,
        "deck": true
      },
      {
        "id": "driver",
        "label": "Motor driver",
        "req_label": "not specified",
        "rated_max_v": null,
        "kit": null,
        "deck": true
      },
      {
        "id": "motors",
        "label": "DC gearmotors ×2",
        "req_label": "11.1 V",
        "rated_max_v": 11.1,
        "kit": "mount",
        "deck": true
      },
      {
        "id": "controller",
        "label": "Controller board",
        "req_label": "not specified",
        "rated_max_v": null,
        "kit": null,
        "deck": true
      },
      {
        "id": "lidar",
        "label": "2D lidar (360°)",
        "req_label": "not specified",
        "rated_max_v": null,
        "kit": "lidar",
        "deck": false
      }
    ],
    "connections": [
      {
        "from": "battery",
        "to": "driver",
        "kind": "power",
        "volts": 11.1,
        "label": "battery rail"
      },
      {
        "from": "driver",
        "to": "motors",
        "kind": "power",
        "volts": 11.1,
        "label": "motor rail — the spec rates the motors at the battery voltage"
      },
      {
        "from": "battery",
        "to": "controller",
        "kind": "power",
        "volts": null,
        "label": "regulated rail (not specified)"
      },
      {
        "from": "controller",
        "to": "driver",
        "kind": "data",
        "volts": null,
        "label": "PWM + direction"
      },
      {
        "from": "controller",
        "to": "lidar",
        "kind": "power",
        "volts": null,
        "label": "power (rail not specified)"
      },
      {
        "from": "controller",
        "to": "lidar",
        "kind": "data",
        "volts": null,
        "label": "lidar data"
      }
    ]
