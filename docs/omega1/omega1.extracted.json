  "findings": [
    {
      "id": "track-wider-than-robot",
      "severity": "high",
      "text": "The motor controller assumes 0.20 m between left and right wheel centres, but the Freenove kit's whole envelope is 0.15 m wide. The code default can't be Omega1's real track, so odometry and turning in a twin built from it would be wrong.",
      "sources": [
        {
          "file": "ros/src/omega_robot/omega_robot/motor_controller_node.py",
          "line": 26,
          "quote": "wheel_base        float   0.20    -- metres between wheel centrelines"
        }
      ]
    },
    {
      "id": "two-wheel-sizes",
      "severity": "medium",
      "text": "The repo gives two wheel sizes: 0.05 m radius as the default and 0.04 m in the launch file's usage example. Neither is labelled as measured.",
      "sources": [
        {
          "file": "ros/src/omega_robot/omega_robot/motor_controller_node.py",
          "line": 27,
          "quote": "wheel_radius      float   0.05    -- metres"
        },
        {
          "file": "ros/launch/omega_hybrid.launch.py",
          "line": 27,
          "quote": "ros2 launch omega_robot omega_hybrid.launch.py wheel_base:=0.18 wheel_radius:=0.04"
        }
      ]
    },
    {
      "id": "loose-pitch-servo",
      "severity": "medium",
      "text": "The pitch servo's range was narrowed to 1300–1700 µs because of loose hardware. That is a real mechanical fault, and it belongs in Omega1's repair list.",
      "sources": [
        {
          "file": "ros/src/omega_robot/omega_robot/servo_controller_node.py",
          "line": 104,
          "quote": "self.declare_parameter('pitch_min_us',    1300)   # tight — loose hardware"
        }
      ]
    },
    {
      "id": "servo-clamp-vs-node-limits",
      "severity": "low",
      "text": "The yaw node allows 1000–2000 µs, but the driver clamps every pulse to 1200–1800 µs, so the real yaw travel is narrower than the parameter says.",
      "sources": [
        {
          "file": "ros/src/omega_robot/omega_robot/servo_controller_node.py",
          "line": 102,
          "quote": "self.declare_parameter('yaw_min_us',      1000)"
        },
        {
          "file": "README.md",
          "line": 80,
          "quote": "| PCA9685 shared PWM clock bug (500 Hz → invalid servo pulses) | Motor driver locked to 50 Hz; `Servo.__init__` reads the PRESCALE register on startup and auto-corrects if another process changed the frequency; all servo pulses hard-clamped to 1200–1800 µs on every command |"
        }
      ]
    },
    {
      "id": "mounts-are-placeholders",
      "severity": "low",
      "text": "The camera and ultrasonic offsets are static-transform defaults that the launch file itself says to adjust to the physical robot. Treat them as estimates until measured.",
      "sources": [
        {
          "file": "ros/launch/omega_hybrid.launch.py",
          "line": 224,
          "quote": "# ---- static transforms (adjust XYZ/RPY to your physical robot) ------"
        }
      ]
    },
    {
      "id": "no-robot-model",
      "severity": "high",
      "text": "The repo has no URDF, xacro or SDF file, so RobotForge's repo import can't simulate Omega1 directly. This file plus the measurements in MEASURE.md is the route to a URDF (robotforge urdf).",
      "sources": []
    }
  ]
}
