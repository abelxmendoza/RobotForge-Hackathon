# GitHub language statistics (Linguist)
#
# The pages below are regenerated by the site build:
# src/robotforge/site.py::build_site renders them from the Robodex and
# parts-catalog data, and they are committed only so GitHub Pages can
# serve them. Marking them linguist-generated keeps the language bar
# pointed at the hand-written source (the Python package and the
# Next.js app in web-next/).
app/index.html linguist-generated=true
app/forge/index.html linguist-generated=true
app/robots/index.html linguist-generated=true
app/robots/*/index.html linguist-generated=true
app/evidence/index.html linguist-generated=true
robodex.html linguist-generated=true
parts.html linguist-generated=true
try.html linguist-generated=true
reports.html linguist-generated=true
assets/js/live-config.js linguist-generated=true

# TypeScript incremental build info, written by tsc on every build.
web-next/tsconfig.tsbuildinfo linguist-generated=true
