# Template for live/safe-upload.sh. Names only, no real values.
#
# Copy it OUTSIDE the repo, then fill it in with a text editor:
#   cp live/secrets.env.example ~/.robotforge-live.secrets.env
#   open -e ~/.robotforge-live.secrets.env      (Mac)
# Never paste a value into chat, an issue or a commit. Delete the
# filled-in copy once the new version is live.
#
# Format: NAME=value on one line, no quotes, no spaces around "=".

# Required: the 8 secrets the known-good version 31dfa75d had.
AUTH_JWT_SECRET=paste-here
BASETEN_API_KEY=paste-here
FIRECRAWL_API_KEY=paste-here
GOOGLE_CLIENT_SECRET=paste-here
META_API_KEY=paste-here
META_APP_ID=paste-here
META_APP_SECRET=paste-here
OPERATOR_TOKEN=paste-here

# Required: Google login's client ID. It was a dashboard variable, so it
# is not in wrangler.toml; it is not secret (it shows in the Google
# sign-in URL), but the Worker needs it.
GOOGLE_CLIENT_ID=paste-here

# Optional: delete these lines if you don't use them.
FIREWORKS_API_KEY=paste-here
GITHUB_CLIENT_ID=paste-here
GITHUB_CLIENT_SECRET=paste-here
